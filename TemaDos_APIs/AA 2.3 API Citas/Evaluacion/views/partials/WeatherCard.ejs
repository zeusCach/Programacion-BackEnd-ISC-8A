<div class="glass rounded-3xl p-6 mb-4">
  <!-- Ubicacion y fecha -->
  <div class="flex justify-between items-start mb-6">
    <div>
      <h1 class="text-white text-3xl font-700 leading-tight"><%= city %></h1>
      <p class="text-white/50 text-sm mt-1"><%= country %></p>
    </div>
    <div class="text-right">
      <p class="text-white/50 text-xs"><%= date %></p>
    </div>
  </div>

  <!-- Temperatura -->
  <div class="flex items-center justify-between mb-6">
    <div>
      <p class="text-white text-8xl font-300 leading-none">
        <%= temp %><span class="text-4xl text-white/60">°C</span>
      </p>
      <p class="text-white/60 text-base mt-2 capitalize"><%= description %></p>
    </div>
    <div
      class="flex items-center justify-center bg-white/10 rounded-full w-32 h-32 backdrop-blur-sm border border-white/20"
    >
      <img
        class="w-20 h-20 object-contain drop-shadow-lg scale-125"
        src="<%= icon  %>"
        alt="clima"
      />
    </div>
  </div>

  <!-- Mas informacion sobre el tiempo (sensacion, humedad, uv, viento, visibilidad) -->
  <div class="flex gap-2 mb-4">
      <div class="glass-dark rounded-2xl px-4 py-3 flex-1 flex items-center gap-3">
      <svg class="w-5 h-5 text-white/50 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0Z"/>
      </svg>
      <div>
        <p class="text-white/40 text-xs">Sensación</p>
        <p class="text-white font-500"><%= feelsLike %>°C</p>
      </div>
</div>

<!-- Humedad -->
<div class="glass-dark rounded-2xl px-4 py-3 flex-1 flex items-center gap-3">
      <svg class="w-5 h-5 text-white/50 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2.25c0 0-7.5 8.25-7.5 13.5a7.5 7.5 0 0 0 15 0C19.5 10.5 12 2.25 12 2.25Z"/>
      </svg>
      <div>
        <p class="text-white/40 text-xs">Humedad</p>
        <p class="text-white font-500"><%= humidity %>%</p>
      </div>
</div>
</div>

    
<div class="flex gap-2">
  
  <!-- Viento -->
    <div class="glass-dark rounded-2xl px-4 py-3 flex-1 flex items-center gap-3">
      <svg
        class="w-5 h-5 text-white/50 shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          d="M17.7 7.7A2.5 2.5 0 1 1 16 12H3M10.7 4.7A2.5 2.5 0 1 1 9 9H3M17.7 16.3A2.5 2.5 0 1 0 16 12H3"
        />
      </svg>
      <div>
        <p class="text-white/40 text-xs">Viento</p>
        <p class="text-white text-sm font-500"><%= wind %> km/h</p>
      </div>
    </div>

<!-- Visibilidad -->
<div class="glass-dark rounded-2xl px-4 py-3 flex-1 flex items-center gap-3">

      <svg
        class="w-5 h-5 text-white/50 shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"
        />
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
        />
      </svg>
      <div>
        <p class="text-white/40 text-xs">Visibilidad</p>
        <p class="text-white text-sm font-500"><%= visibility %> km</p>
      </div>
    </div>
</div>
</div>
