<form action="/" method="get" class="mb-6 flex gap-2">
    <input 
        type="text"
        name="city"
        placeholder="Busca tu ciudad, Ej. Cancún"      
        value="<%= city %>"  
        class="flex-1 glass text-white placeholder-white/40 rounded-2xl px-5 py-3 text-sm outline-none focus:border-white/40 transition-all"    
    >
             
    <button 
        type="submit" 
        class="glass text-white rounded-2xl px-5 py-3 hover:bg-white/20 transition-all active:scale-95">
        
        <svg 
            xmlns="http://www.w3.org/2000/svg" 
            class="w-5 h-5" 
            fill="none" 
            viewBox="0 0 24 24"         
            stroke="currentColor"
        >

        <path 
            stroke-linecap="round" 
            stroke-linejoin="round" 
            stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"
        />
        </svg>
    </button>

</form>
